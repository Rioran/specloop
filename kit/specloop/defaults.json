{
  "commandPrefix": "sl-",
  "initialPhase": "plan",
  "maxIterations": 15,
  "checkTimeoutSec": 900,
  "maxOutputChars": 4000,
  "shell": "bash",
  "blockedCommandsUntilDone": ["git push", "gh pr create", "gh pr merge"],
  "largeSpecWarning": { "maxLines": 200, "maxWords": 2000, "maxPlanItems": 12 },
  "feature": {
    "branchPrefix": "specloop/",
    "planPhase": "feature-plan",
    "requirePlanApproval": true,
    "gitTimeoutSec": 60,
    "planPhases": {
      "feature-plan": {
        "delegate": true,
        "allowEdits": [".claude/specloop/run/"],
        "check": { "type": "steps", "path": ".claude/specloop/run/steps.json", "requireAllPending": true }
      }
    }
  },
  "phases": {
    "plan": {
      "next": "implement",
      "allowEdits": [".claude/specloop/run/"],
      "check": { "type": "file", "path": ".claude/specloop/run/plan.md" }
    },
    "implement": {
      "next": "review",
      "check": null
    },
    "review": {
      "next": "done",
      "allowEdits": [".claude/specloop/run/"],
      "check": {
        "type": "verdict",
        "path": ".claude/specloop/run/review.md",
        "approve": "VERDICT: APPROVE",
        "reject": "VERDICT: CHANGES_REQUESTED",
        "onReject": "implement"
      }
    }
  }
}
